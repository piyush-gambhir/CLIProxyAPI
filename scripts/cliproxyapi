#!/usr/bin/env python3
"""Start the installed proxy release using its proxy-owned service configuration."""
import os
from pathlib import Path
import runpy
import sys
settings=runpy.run_path(str(Path(__file__).with_name('proxy-service.py')))
binary=str(settings['ROOT']/'current'/'cliproxyapi')
args=sys.argv[1:]
if args and args[0]=='claude':
    argv=[binary,'claude','--proxy-config',str(settings['CONFIG']),*args[1:]]
else:
    argv=[binary,'-config',str(settings['CONFIG']),*args]
os.execv(binary,argv)
